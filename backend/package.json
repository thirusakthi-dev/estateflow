{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "Stable-first Express TypeScript Prisma backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate --no-hints && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "make:module": "tsx scripts/generate.ts module",
    "make:file": "tsx scripts/generate.ts file",
    "check:updates": "npm outdated",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.22.3",
    "express-rate-limit": "8.7.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "22.19.1",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "openapi-types": "^12.1.3",
    "prisma": "^7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
