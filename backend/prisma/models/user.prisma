model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  avatarUrl    String?
  linkedinUrl  String?
  websiteUrl   String?
  role         UserRole @default(SALES_EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads Lead[]     @relation("AssignedLeads")
  createdLeads  Lead[]     @relation("CreatedLeads")
  leadNotes     LeadNote[]
  followUps     FollowUp[]
  bookings      Booking[]
}
