model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  status      ProjectStatus @default(ACTIVE)

  minPrice    Decimal?      @db.Decimal(14, 2)
  maxPrice    Decimal?      @db.Decimal(14, 2)

  contactName  String?
  contactPhone String?
  contactEmail String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  buildings Building[]
  images    ProjectImage[]

  @@index([city, status])
}