model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  address     String
  city        String
  status      ProjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  buildings Building[]
  images    ProjectImage[]

  @@index([city, status])
}
